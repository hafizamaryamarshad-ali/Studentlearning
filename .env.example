# Public Supabase project settings. Safe for browser use and still protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never prefix privileged server-only secrets with NEXT_PUBLIC_.
# Add a service-role key only when a future trusted server workflow requires it.
# SUPABASE_SERVICE_ROLE_KEY=
